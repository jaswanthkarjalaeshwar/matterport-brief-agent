# Required for live runs. Without it the app serves sample briefs only.
OPENROUTER_API_KEY=
# Comma-separated. First is primary, the rest are fallbacks tried in order.
BRIEF_MODELS=anthropic/claude-haiku-5.5,google/gemini-3.8-flash,openai/gpt-6-luna

# Web research: set one. Exa is preferred when both are set.
EXA_API_KEY=
MONID_API_KEY=
MONID_BUDGET_USD=0.05

# Long-term memory (optional)
MEM0_API_KEY=

# Tracing (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Abuse guard for the public link
BRIEFS_PER_MINUTE=3
